<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Volunteer Dashboard - Street Dog Care</title>
    <!-- Bootstrap 5 CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Specific tweaks for dashboard */
        .welcome-banner {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: white;
            border-radius: 1.5rem;
            padding: 2.5rem;
            box-shadow: 0 8px 25px rgba(255, 107, 107, 0.3);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }
        .welcome-banner::after {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
        }
        .stat-card {
            background: var(--white);
            border: none;
            border-radius: 1.2rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.04);
            transition: var(--transition);
            text-align: center;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        .stat-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--dark-text);
        }
        .stat-title {
            color: #636e72;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .table-custom {
            background-color: #fff;
            border-radius: 1.2rem;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.04);
        }
        .table-custom th {
            background-color: #f8f9fa;
            color: var(--dark-text);
            font-weight: 700;
            padding: 1.2rem 1rem;
            border-bottom: 2px solid #eaeaea;
        }
        .table-custom td {
            padding: 1.2rem 1rem;
            vertical-align: middle;
            color: #2d3436;
            border-bottom: 1px solid #f8f9fa;
        }
        body { padding-top: 80px; } /* for fixed navbar */
    </style>
</head>
<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/volunteer/dashboard">
                <i class="bi bi-suit-heart-fill"></i> Street Dog Care
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link active" href="/volunteer/dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/volunteer/reports">Dog Reports</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/dogs">Dog Profiles</a>
                    </li>
                    <li class="nav-item mx-3">
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-person-heart me-1"></i> Volunteer
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-danger btn-sm rounded-pill px-3" href="/logout">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container py-4">
        
        <!-- Welcome Section -->
        <div class="welcome-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <span class="badge bg-white text-danger rounded-pill px-3 py-1 mb-3 fw-bold shadow-sm">
                    <i class="bi bi-star-fill me-1"></i> Top Contributor
                </span>
                <h2 class="fw-bold mb-2 display-6">Welcome back, <%= user.name %>!</h2>
                <p class="mb-0 fs-5 text-white-50">Thank you for making a difference in these animals' lives today.</p>
            </div>
            <div class="mt-4 mt-md-0 d-flex gap-2 z-1">
                <a href="/report-dog" class="btn btn-light text-danger fw-bold rounded-pill px-4 py-2">
                    <i class="bi bi-megaphone-fill me-2"></i> Report Dog
                </a>
            </div>
        </div>

        <!-- Dashboard Statistics -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-4 mb-5">
            <div class="col">
                <div class="card stat-card h-100 py-4">
                    <div class="card-body p-0">
                        <div class="stat-icon text-primary"><i class="bi bi-clipboard-heart"></i></div>
                        <div class="stat-number"><%= stats.totalReports %></div>
                        <div class="stat-title">Total Reports</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100 py-4">
                    <div class="card-body p-0">
                        <div class="stat-icon text-info"><i class="bi bi-person-lines-fill"></i></div>
                        <div class="stat-number"><%= stats.assignedReports %></div>
                        <div class="stat-title">My Assigned</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100 py-4">
                    <div class="card-body p-0">
                        <div class="stat-icon text-secondary"><i class="bi bi-file-earmark-text"></i></div>
                        <div class="stat-number"><%= stats.reported %></div>
                        <div class="stat-title">New Reports</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100 py-4">
                    <div class="card-body p-0">
                        <div class="stat-icon text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                        <div class="stat-number"><%= stats.critical %></div>
                        <div class="stat-title">Critical</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100 py-4">
                    <div class="card-body p-0">
                        <div class="stat-icon text-warning"><i class="bi bi-hospital"></i></div>
                        <div class="stat-number"><%= stats.underTreatment %></div>
                        <div class="stat-title">In Treatment</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100 py-4">
                    <div class="card-body p-0">
                        <div class="stat-icon text-success"><i class="bi bi-heart"></i></div>
                        <div class="stat-number"><%= stats.rescued %></div>
                        <div class="stat-title">Rescued</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="d-flex flex-wrap gap-3 p-4 bg-white rounded-4 shadow-sm border border-light">
                    <h5 class="fw-bold mb-0 me-3 d-flex align-items-center" style="color: var(--dark-text);">
                        <i class="bi bi-lightning-charge-fill text-warning fs-3 me-2"></i> Quick Actions
                    </h5>
                    <a href="/volunteer/assigned-reports" class="btn btn-custom px-4 rounded-pill">
                        <i class="bi bi-person-lines-fill me-2"></i>My Assigned Reports
                    </a>
                    <a href="/volunteer/reports" class="btn btn-outline-custom px-4 rounded-pill">
                        <i class="bi bi-card-list me-2"></i>View All Reports
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Reports Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold m-0" style="color: var(--dark-text);">Recent Reports Overview</h4>
            <a href="/volunteer/reports" class="btn btn-outline-secondary rounded-pill px-4">View All</a>
        </div>
        
        <div class="table-responsive table-custom mb-5 border-0">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">Dog Name</th>
                        <th scope="col">Location</th>
                        <th scope="col">Condition</th>
                        <th scope="col">Status</th>
                        <th scope="col">Date</th>
                        <th scope="col" class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentReports && recentReports.length > 0) { %>
                        <% recentReports.forEach(report => { %>
                            <tr>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle p-2 me-3 text-secondary">
                                            <i class="bi bi-c-circle-fill"></i>
                                        </div>
                                        <%= report.dogName ? report.dogName : 'Unnamed Dog' %>
                                    </div>
                                </td>
                                <td><i class="bi bi-geo-alt-fill text-danger me-2"></i><%= report.location %></td>
                                <td>
                                    <% 
                                        let condClass = 'bg-secondary';
                                        let condLabel = 'Unknown';
                                        if (report.condition === 'healthy') { condClass = 'bg-success'; condLabel = 'Healthy'; }
                                        else if (report.condition === 'injured') { condClass = 'bg-warning text-dark'; condLabel = 'Injured'; }
                                        else if (report.condition === 'sick') { condClass = 'bg-danger'; condLabel = 'Sick'; }
                                        else if (report.condition === 'critical') { condClass = 'bg-dark'; condLabel = 'Critical'; }
                                    %>
                                    <span class="badge <%= condClass %> rounded-pill px-3 py-2"><%= condLabel %></span>
                                </td>
                                <td>
                                    <% 
                                        let statClass = 'bg-secondary';
                                        let statLabel = 'Reported';
                                        if (report.status === 'reported') { statClass = 'bg-primary'; statLabel = 'Reported'; }
                                        else if (report.status === 'rescued') { statClass = 'bg-info text-dark'; statLabel = 'Rescued'; }
                                        else if (report.status === 'under_treatment') { statClass = 'bg-warning text-dark'; statLabel = 'Under Treatment'; }
                                        else if (report.status === 'adopted') { statClass = 'bg-success'; statLabel = 'Adopted'; }
                                        else if (report.status === 'closed') { statClass = 'bg-secondary'; statLabel = 'Closed'; }
                                    %>
                                    <span class="badge <%= statClass %> bg-opacity-10 text-dark border border-light rounded-pill px-3 py-2"><%= statLabel %></span>
                                </td>
                                <td class="text-muted fw-medium"><%= new Date(report.createdAt).toLocaleDateString() %></td>
                                <td class="text-end pe-4">
                                    <a href="/volunteer/reports/<%= report._id %>" class="btn btn-outline-custom btn-sm rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted my-4">
                                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                                        <i class="bi bi-inbox fs-1 text-secondary"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark">No dog reports available yet.</h5>
                                    <p>When someone reports a dog, it will appear here.</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

    </div>

    <!-- Bootstrap 5 JS Bundle via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
