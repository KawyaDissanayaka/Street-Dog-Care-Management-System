<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Street Dog Care System - Compassion in Action</title>
    <!-- Bootstrap 5 CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-suit-heart-fill"></i> Street Dog Care
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/dogs">Meet the Dogs</a>
                    </li>
                    <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                        <a class="btn btn-outline-custom me-2 w-100 w-lg-auto" href="/login">Login</a>
                    </li>
                    <li class="nav-item mt-2 mt-lg-0">
                        <a class="btn btn-custom w-100 w-lg-auto" href="/register">Register</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-shape"></div>
        <div class="hero-shape-2"></div>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-start">
                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 mb-3 fw-medium">
                        <i class="bi bi-star-fill me-1"></i> Make a Difference Today
                    </span>
                    <h1 class="hero-title">
                        Give Every Street Dog a <span>Second Chance</span> at Life
                    </h1>
                    <p class="hero-subtitle">
                        Join our community of volunteers and animal lovers. Report injured dogs, track medical treatments, and help them find their forever homes.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                        <a href="/login" class="btn btn-custom btn-lg px-4">
                            Report a Dog <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                        <a href="/dogs" class="btn btn-outline-custom btn-lg px-4">
                            View Dogs
                        </a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <img src="https://images.unsplash.com/photo-1548681528-6a5c45b66b42?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Happy rescued dog" class="hero-image img-fluid">
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="features-section">
        <div class="container">
            <h2 class="section-title">How It Works</h2>
            <div class="row g-4">
                <!-- Feature 1 -->
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <h3 class="feature-title">Report & Locate</h3>
                        <p class="feature-text">Easily report stray dogs in need of help by providing their location, photos, and current health condition.</p>
                    </div>
                </div>
                <!-- Feature 2 -->
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-heart-pulse"></i>
                        </div>
                        <h3 class="feature-title">Medical Care</h3>
                        <p class="feature-text">Our assigned volunteers track veterinary treatments, vaccinations, and recovery progress transparently.</p>
                    </div>
                </div>
                <!-- Feature 3 -->
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-house-heart"></i>
                        </div>
                        <h3 class="feature-title">Foster & Adopt</h3>
                        <p class="feature-text">Connect recovered dogs with loving families through our streamlined adoption process and network.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-5 bg-danger bg-opacity-10">
        <div class="container text-center py-5">
            <h2 class="fw-bold mb-4">Ready to Change a Life?</h2>
            <p class="text-muted mb-4 fs-5 mx-auto" style="max-width: 600px;">
                Whether you can adopt, foster, or simply report a dog in need, your action matters.
            </p>
            <a href="/register" class="btn btn-custom btn-lg px-5">Join as a Volunteer</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a href="#" class="footer-brand"><i class="bi bi-suit-heart-fill me-2"></i>Street Dog Care</a>
                    <p class="footer-text mt-3">
                        A dedicated platform to rescue, treat, and find loving homes for street dogs in our community. Every life counts.
                    </p>
                </div>
                <div class="col-lg-2 offset-lg-2">
                    <h5 class="text-white mb-3">Quick Links</h5>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/dogs">Dog Profiles</a></li>
                        <li><a href="/login">Login</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5 class="text-white mb-3">Contact Us</h5>
                    <ul class="footer-links">
                        <li><a href="#"><i class="bi bi-envelope me-2"></i> help@streetdogcare.org</a></li>
                        <li><a href="#"><i class="bi bi-telephone me-2"></i> +94 11 234 5678</a></li>
                    </ul>
                    <div class="d-flex gap-3 mt-4">
                        <a href="#" class="text-white fs-4"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white fs-4"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white fs-4"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
            </div>
            <div class="text-center mt-5 pt-4 border-top border-secondary">
                <p class="mb-0 text-muted">&copy; 2026 Street Dog Care Management System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
