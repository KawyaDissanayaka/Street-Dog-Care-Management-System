<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Street Dog Care</title>
    <!-- Bootstrap 5 CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <!-- Bootstrap Icons via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .brand-logo {
            font-size: 2.2rem;
            color: #d35400; /* Warm orange theme for animal care */
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .card-custom {
            border-radius: 1.25rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border: none;
            overflow: hidden;
        }
        .card-header-custom {
            background-color: #fff;
            border-bottom: 2px solid #fdf2e9;
            padding-top: 2rem;
            padding-bottom: 1rem;
        }
        .btn-custom {
            background-color: #d35400;
            color: white;
            border-radius: 0.5rem;
            padding: 0.75rem;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.2s;
        }
        .btn-custom:hover {
            background-color: #e67e22;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(211, 84, 0, 0.2);
        }
        .form-control {
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            border: 1px solid #ced4da;
        }
        .form-control:focus {
            border-color: #d35400;
            box-shadow: 0 0 0 0.25rem rgba(211, 84, 0, 0.25);
        }
        .form-label {
            font-weight: 600;
            color: #495057;
        }
        .icon-container {
            font-size: 4rem;
            color: #e67e22;
            margin-bottom: -1rem;
        }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-4">
                
                <!-- Branding -->
                <div class="text-center mb-4">
                    <div class="brand-logo mb-2"><i class="bi bi-suit-heart-fill text-danger me-2"></i>🐾 Street Dog Care</div>
                </div>

                <!-- Login Card -->
                <div class="card card-custom">
                    <div class="card-header-custom text-center">
                        <div class="icon-container">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <h3 class="mt-3 mb-1 fw-bold" style="color: #2c3e50;">Welcome Back</h3>
                        <p class="text-muted px-4">Login to continue helping street dogs.</p>
                    </div>
                    
                    <div class="card-body p-4 p-md-5 pt-3">
                        
                        <!-- Form targeting POST /login -->
                        <form method="POST" action="/login">
                            
                            <!-- Email -->
                            <div class="mb-4">
                                <label for="email" class="form-label"><i class="bi bi-envelope-fill text-muted me-2"></i>Email Address</label>
                                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                            </div>
                            
                            <!-- Password -->
                            <div class="mb-4">
                                <label for="password" class="form-label"><i class="bi bi-lock-fill text-muted me-2"></i>Password</label>
                                <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" minlength="6" required>
                            </div>
                            
                            <!-- Submit Button -->
                            <div class="d-grid gap-2 mb-4 mt-2">
                                <button type="submit" class="btn btn-custom">Login</button>
                            </div>
                        </form>
                        
                        <!-- Register Link -->
                        <div class="text-center mt-2">
                            <p class="mb-0 text-muted">Don't have an account? <a href="/register" class="text-decoration-none fw-bold" style="color: #d35400;">Create an account</a></p>
                        </div>

                    </div>
                </div>
                
                <!-- Footer note -->
                <div class="text-center mt-4 text-muted small">
                    <p>&copy; 2026 Street Dog Care Management System</p>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
</body>
</html>
